/* =====================================================================
   🌸 GOLESTOON MODERN DESIGN SYSTEM (PyQt5 QSS)
   TailwindCSS & shadcn Slate Design Tokens
   Designed for Iranian University Students (Vazirmatn / Shabnam Typography)
   ===================================================================== */

/* --- 1. Global Reset & Typography --- */
* {
    font-family: "Vazirmatn", "Vazir", "Shabnam", "IRANSans", "Segoe UI", "Tahoma", sans-serif;
    font-size: 12px;
    outline: none;
}

/* --- 2. Main Window & Backgrounds --- */
QMainWindow {
    background-color: #f8fafc;
    color: #0f172a;
}

/* Base Widget Surfaces */
QWidget#centralwidget {
    background-color: #f8fafc;
}

/* Base text labels */
QLabel {
    color: #0f172a;
    background: transparent;
}

QLabel:disabled {
    color: #94a3b8;
}

/* Left, Center, Right Surface Panels */
#left_panel, #center_panel, #right_panel, #courses_panel, #schedule_panel, #info_panel {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 12px;
    padding: 8px;
}

/* Splitter dividers */
QSplitter::handle {
    background-color: #e2e8f0;
    width: 2px;
    height: 2px;
}

QSplitter::handle:hover {
    background-color: #2563eb;
}

/* --- 3. Modern Interactive Buttons --- */
QPushButton {
    background-color: #2563eb;
    color: #ffffff;
    border: 1px solid #1d4ed8;
    border-radius: 8px;
    padding: 7px 14px;
    font-size: 12px;
    font-weight: bold;
    min-height: 26px;
}

QPushButton:hover {
    background-color: #1d4ed8;
    border-color: #1e40af;
}

QPushButton:pressed {
    background-color: #1e40af;
}

QPushButton:disabled {
    background-color: #e2e8f0;
    color: #94a3b8;
    border: 1px solid #cbd5e1;
}

/* Success Buttons (Emerald Green) */
QPushButton#success_btn, QPushButton#add_to_auto_btn, QPushButton#add_custom_course_btn {
    background-color: #10b981;
    border: 1px solid #059669;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#success_btn:hover, QPushButton#add_to_auto_btn:hover, QPushButton#add_custom_course_btn:hover {
    background-color: #059669;
    border-color: #047857;
}

QPushButton#success_btn:pressed, QPushButton#add_to_auto_btn:pressed, QPushButton#add_custom_course_btn:pressed {
    background-color: #047857;
}

/* Danger Buttons (Rose Red) */
QPushButton#danger_btn, QPushButton#remove_course_btn, QPushButton#clear_schedule_btn, QPushButton#remove_from_auto_btn, QPushButton#delete_combination_btn {
    background-color: #ef4444;
    border: 1px solid #dc2626;
    color: #ffffff;
    font-weight: bold;
}

QPushButton#danger_btn:hover, QPushButton#remove_course_btn:hover, QPushButton#clear_schedule_btn:hover, QPushButton#remove_from_auto_btn:hover, QPushButton#delete_combination_btn:hover {
    background-color: #dc2626;
    border-color: #b91c1c;
}

QPushButton#danger_btn:pressed, QPushButton#remove_course_btn:pressed, QPushButton#clear_schedule_btn:pressed, QPushButton#remove_from_auto_btn:pressed, QPushButton#delete_combination_btn:pressed {
    background-color: #b91c1c;
}

/* Secondary & Neutral Buttons */
QPushButton#secondary_btn, QPushButton#cancel_btn, QPushButton#save_schedule_btn, QPushButton#save_combination_btn {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    font-weight: 600;
}

QPushButton#secondary_btn:hover, QPushButton#cancel_btn:hover, QPushButton#save_schedule_btn:hover, QPushButton#save_combination_btn:hover {
    background-color: #e2e8f0;
    color: #0f172a;
    border-color: #94a3b8;
}

/* Action Generator Button */
QPushButton#optimal_schedule_btn, QPushButton#generate_schedule_btn {
    background-color: #2563eb;
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-weight: bold;
    border-radius: 8px;
    padding: 8px 16px;
}

QPushButton#optimal_schedule_btn:hover, QPushButton#generate_schedule_btn:hover {
    background-color: #1d4ed8;
}

/* --- 4. Form Controls, Text Inputs & Dropdowns --- */
QLineEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px 10px;
    font-size: 12px;
    selection-background-color: #2563eb;
    selection-color: #ffffff;
}

QLineEdit:focus {
    border: 1.5px solid #2563eb;
    background-color: #ffffff;
}

QLineEdit:disabled {
    background-color: #f1f5f9;
    color: #94a3b8;
    border-color: #e2e8f0;
}

QComboBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 5px 10px;
    font-size: 12px;
    min-height: 26px;
}

QComboBox:hover {
    border-color: #94a3b8;
}

QComboBox:focus {
    border: 1.5px solid #2563eb;
}

QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top left;
    width: 20px;
    border-left: none;
}

QComboBox QAbstractItemView {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 6px;
    selection-background-color: #eff6ff;
    selection-color: #1d4ed8;
    padding: 4px;
}

/* --- 5. Group Boxes & Cards --- */
QGroupBox {
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    margin-top: 14px;
    padding-top: 14px;
    font-weight: bold;
    font-size: 12px;
    color: #0f172a;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top right;
    right: 12px;
    padding: 2px 8px;
    color: #2563eb;
    background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
}

/* --- 6. List Widgets (Course & Saved Combos) --- */
QListWidget {
    background-color: #ffffff;
    alternate-background-color: #f8fafc;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    padding: 4px;
    color: #0f172a;
}

QListWidget::item {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    padding: 8px 10px;
    color: #0f172a;
    margin-bottom: 4px;
}

QListWidget::item:hover {
    background-color: #e2e8f0;
    border-color: #cbd5e1;
    color: #0f172a;
}

QListWidget::item:selected {
    background-color: #2563eb;
    border: 1px solid #1d4ed8;
    color: #ffffff;
    font-weight: bold;
}

/* --- 7. Schedule Table Widget --- */
QTableWidget {
    background-color: #ffffff;
    alternate-background-color: #ffffff;
    border: 1px solid #e2e8f0;
    border-radius: 8px;
    gridline-color: #e2e8f0;
    selection-background-color: #eff6ff;
    selection-color: #1d4ed8;
    color: #0f172a;
    font-size: 11px;
}

QTableWidget::item {
    padding: 1px;
    border: none;
    background: transparent;
    color: #0f172a;
}

QTableWidget QTableCornerButton::section {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
}

/* Table Horizontal Headers (Days) */
QHeaderView {
    background-color: transparent;
    border: none;
}

QHeaderView::section {
    background-color: #f1f5f9;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    font-weight: bold;
    font-size: 12px;
    text-align: center;
}

QHeaderView::section:horizontal {
    background-color: #f1f5f9;
    color: #0f172a;
    padding: 8px 4px;
    border-top: none;
    border-right: none;
    border-bottom: 1px solid #e2e8f0;
    border-left: 1px solid #e2e8f0;
    font-weight: bold;
    font-size: 12px;
}

/* Table Vertical Headers (Time Slots) */
QHeaderView::section:vertical {
    background-color: #f1f5f9;
    color: #0f172a;
    padding: 2px 6px;
    border-top: none;
    border-right: none;
    border-left: 1px solid #e2e8f0;
    border-bottom: 1px solid #e2e8f0;
    font-weight: bold;
    font-size: 12px;
    text-align: center;
}

/* --- 8. Tab Widget & Pages --- */
QTabWidget::pane {
    border: 1px solid #e2e8f0;
    background-color: #ffffff;
    border-radius: 8px;
    padding: 8px;
}

QTabBar::tab {
    background-color: #f1f5f9;
    color: #475569;
    padding: 8px 16px;
    margin-left: 3px;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    font-weight: bold;
    font-size: 12px;
}

QTabBar::tab:hover {
    background-color: #e2e8f0;
    color: #0f172a;
}

QTabBar::tab:selected {
    background-color: #ffffff;
    color: #2563eb;
    border-bottom: 2px solid #2563eb;
}

/* --- 9. Menu Bar & Dropdown Menus --- */
QMenuBar {
    background-color: #ffffff;
    color: #0f172a;
    border-bottom: 1px solid #e2e8f0;
    padding: 3px 6px;
    font-size: 12px;
    font-weight: 500;
}

QMenuBar::item {
    background: transparent;
    padding: 6px 10px;
    border-radius: 6px;
    color: #0f172a;
}

QMenuBar::item:selected {
    background-color: #f1f5f9;
    color: #2563eb;
}

QMenu {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    padding: 6px 20px 6px 24px;
    border-radius: 6px;
    color: #0f172a;
}

QMenu::item:selected {
    background-color: #eff6ff;
    color: #1d4ed8;
}

QMenu::separator {
    height: 1px;
    background-color: #e2e8f0;
    margin: 4px 6px;
}

/* --- 10. Status Bar --- */
QStatusBar {
    background-color: #ffffff;
    color: #334155;
    border-top: 1px solid #e2e8f0;
    padding: 4px 10px;
    font-size: 11.5px;
    font-weight: 500;
}

/* --- 11. Scrollbars --- */
QScrollBar:vertical {
    background-color: #f8fafc;
    width: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:vertical {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0;
    border: none;
}

QScrollBar:horizontal {
    background-color: #f8fafc;
    height: 8px;
    border-radius: 4px;
    margin: 0;
}

QScrollBar::handle:horizontal {
    background-color: #cbd5e1;
    border-radius: 4px;
    min-width: 24px;
}

QScrollBar::handle:horizontal:hover {
    background-color: #94a3b8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    width: 0;
    border: none;
}

/* --- 12. Schedule Grid Course Cells (weekly plan blocks) --- */
QWidget#course-cell {
    border-radius: 8px;
}

QWidget#course-cell QLabel#course-name-label {
    font-size: 11px;
    font-weight: bold;
    background: transparent;
}

QWidget#course-cell QLabel#professor-label {
    font-size: 9.5px;
    background: transparent;
    opacity: 0.95;
}

QWidget#course-cell QLabel#code-label {
    font-size: 9px;
    background: transparent;
}

/* Round subtle remove (✕) button on course cells */
QPushButton#close-btn {
    background-color: rgba(239, 68, 68, 0.15);
    color: #ef4444;
    border: none;
    border-radius: 9px;
    font-size: 10px;
    font-weight: bold;
}

QPushButton#close-btn:hover {
    background-color: #ef4444;
    color: #ffffff;
}

/* Parity chips (ف = odd / ز = even weeks) */
QLabel#parity-label-odd, QLabel#parity-label-even, QLabel#parity-label-all {
    font-size: 9px;
    font-weight: bold;
    padding: 1px 6px;
    border-radius: 7px;
    background: transparent;
}

QLabel#parity-label-odd { color: #d97706; }
QLabel#parity-label-even { color: #0284c7; }
QLabel#parity-label-all { color: #64748b; }

/* --- 13. Dialogs, Alerts & Message Boxes --- */
QDialog {
    background-color: #f8fafc;
    color: #0f172a;
}

QMessageBox {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
}

QMessageBox QLabel {
    color: #0f172a;
    background: transparent;
    font-size: 12px;
}

QMessageBox QPushButton {
    min-width: 80px;
    padding: 6px 14px;
}

QToolTip {
    background-color: #1e293b;
    color: #f8fafc;
    border: 1px solid #334155;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 11px;
}

QTextEdit, QPlainTextEdit {
    background-color: #ffffff;
    color: #0f172a;
    border: 1px solid #cbd5e1;
    border-radius: 8px;
    padding: 6px;
}

QProgressBar {
    background-color: #f1f5f9;
    border: 1px solid #e2e8f0;
    border-radius: 6px;
    text-align: center;
    color: #0f172a;
    font-weight: bold;
}

QProgressBar::chunk {
    background-color: #2563eb;
    border-radius: 5px;
}

