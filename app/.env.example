# ============================================================
# Golestoon Class Planner — Desktop Client Environment
# ============================================================
# Copy this file to app/.env and adjust values if needed.
# SECURITY RULES:
#   - NEVER put server-side secrets here (JWT_SECRET, DB
#     connection strings, hash salts). The desktop client
#     talks ONLY to the REST API, never to the databases.
#   - NEVER commit the real app/.env to git (it is
#     gitignored). This example file is the only tracked one.
# ============================================================

# Base URL of the Golestoon cloud backend (REST API).
# Defaults to production; override only for local development.
# GOLESTOON_API_BASE_URL=https://api.example.com

# Legacy alias kept for backward compatibility with older code paths.
# API_URL=https://api.example.com

# Log level for the desktop client (DEBUG, INFO, WARNING, ERROR).
GOLESTOON_LOG_LEVEL=INFO

# ------------------------------------------------------------
# OPTIONAL — local development convenience only.
# The full desktop app does NOT require these; when absent,
# the app asks for Golestan credentials through its UI and
# stores them locally via the credentials manager.
# ------------------------------------------------------------
# USERNAME=your_golestan_student_number
# PASSWORD=your_golestan_password
